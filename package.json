{
  "name": "ember-web",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Ember in the browser: a messenger client for a Hearth server, installable as a PWA.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
